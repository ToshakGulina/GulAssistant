# Скопируйте в .env и заполните. Файл .env не попадает в Git.
# GigaChat: developers.sber.ru → GigaChat API → «Для физических лиц» (Freemium)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Groq — самый быстрый бесплатный мозг: console.groq.com/keys
# Из РФ прямой доступ закрыт (403). Выберите один из вариантов:
#   а) релей на Cloudflare Worker — docs/GROQ.md (рекомендую, VPN не нужен);
#   б) VPN/прокси: GROQ_API_KEY + network.proxy в config.yaml.
GROQ_API_KEY=
# Релей: URL вида https://gul-groq-relay.ВАШ-АККАУНТ.workers.dev/openai/v1
GROQ_RELAY_URL=
# Токен релея (секрет RELAY_TOKEN в Worker). Без него релей открыт всем.
GROQ_RELAY_TOKEN=

# Cloudflare Workers AI: dash.cloudflare.com → Workers & Pages → AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
